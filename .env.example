LIGHTX_API_KEY=

# Product session limits (see docs/integration-contract.md). Safe pilot
# defaults — not billing rules.
CHUKU_INCLUDED_GENERATIONS=3
CHUKU_MAX_GENERATIONS_PER_SESSION=5

# Retention (see docs/retention.md). Provisional engineering defaults,
# REQUIRES_PRODUCT_PRIVACY_APPROVAL before being treated as policy.
CHUKU_SOURCE_RETENTION_HOURS=24
CHUKU_RESULT_RETENTION_HOURS=72

# Internal (MEKKY <-> Chuku) integration — Phase 4.1B. Server-only, never
# committed, never sent to a browser. CHUKU_HOST's safe default is
# 127.0.0.1 — do not set it to 0.0.0.0 without a deliberate, reviewed reason.
CHUKU_HOST=127.0.0.1
CHUKU_INTERNAL_AUTH_SECRET=
# Comma-separated exact hostnames MEKKY's signed source URLs are allowed to
# target, e.g. your-project-ref.supabase.co
CHUKU_INTERNAL_SOURCE_ALLOWED_HOSTS=
CHUKU_INTERNAL_SOURCE_FETCH_TIMEOUT_MS=10000
CHUKU_INTERNAL_SOURCE_MAX_BYTES=8388608
